# ==============================================================================
# Lupiva Environment Configuration Example
# Copy this file to `.env` before running locally:
#   cp .env.example .env
# Generate unique 32-byte hex keys using:
#   openssl rand -hex 32
# ==============================================================================

# --- PostgreSQL (matches docker-compose.yml defaults) ---
POSTGRES_USER="lupiva"
POSTGRES_PASSWORD="lupiva_dev_password"
POSTGRES_DB="lupiva"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://lupiva:lupiva_dev_password@localhost:5432/lupiva"

# --- PII / PHI Encryption & Session Security ---
# IMPORTANT: All three keys MUST be 32-byte keys (64 hex chars or base64)
# and MUST be distinct from one another. Never commit `.env`.
ENCRYPTION_MASTER_KEY="<replace-with-openssl-rand-hex-32>"
BLIND_INDEX_KEY="<replace-with-different-openssl-rand-hex-32>"
AUTH_SECRET="<replace-with-different-openssl-rand-hex-32>"

# --- Auth & Evaluation Settings ---
# Set to "true" during local/challenge evaluation to enable 1-click Demo Autofill.
# Set to "false" in clinical production.
NEXT_PUBLIC_DEMO_MODE="true"

# Required when creating a new Clinical Specialist account on /api/auth/register
SPECIALIST_INVITE_CODE="VINMEC-IMMUNO-2026"

# Optional override for Secure cookie flag (auto-detected over HTTPS in production)
# COOKIE_SECURE="false"

# --- Phase 2: MinIO / S3 Envelope-Encrypted Document Vault (profile: storage) ---
# Start with: docker compose --profile storage up -d
# MINIO_ROOT_USER="lupiva_minio_admin"
# MINIO_ROOT_PASSWORD="lupiva_minio_secret_2026"
# S3_ENDPOINT="http://localhost:9000"
# S3_BUCKET="lupiva-clinical-vault"
# S3_ACCESS_KEY="lupiva_minio_admin"
# S3_SECRET_KEY="lupiva_minio_secret_2026"

# --- Python OCR/CRF backend (registry_review.server, listening on 127.0.0.1 only) ---
# Next.js proxies /api/pipeline/* to it; the backend is the source of truth for CRF data.
PIPELINE_URL="http://127.0.0.1:8881"
# Extraction engine for patient submissions (see registry_review intake engines).
PIPELINE_ENGINE="gemini"
# Encrypted source images (ciphertext only; keep outside the web root, back it up with the database).
UPLOAD_DIR=".data/uploads"

