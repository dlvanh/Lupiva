# Backend (registry_review / ocr_pool). Copy to .env in the repo root; never commit .env.
# Variable names are the ones the code reads; values here are empty placeholders.
# The web app has its own web/.env.example.

# LLM endpoint for flows A, B and C (OpenAI-compatible; the GEMINI_ prefix is historical).
GEMINI_API_KEY=
GEMINI_MODEL=
# HTTPS, or http://127.0.0.1:<port> for a local proxy
GEMINI_BASE_URL=

# Optional second engine (--engine tokenharbor)
TOKENHARBOR_API_KEY=
TOKENHARBOR_MODEL=
TOKENHARBOR_BASE_URL=

# Flow A only (synthetic images): send the whole unmasked image, no local OCR.
LUPIVA_PROTOTYPE_DIRECT_LLM=0

# Test data only: send every image automatically without manual privacy review.
LUPIVA_TEST_AUTO_SEND=0

# Intake limits (seconds)
# LUPIVA_INTAKE_TIME_LIMIT=
# LUPIVA_INTAKE_STALE_SECONDS=
# LUPIVA_API_SLOW_SECONDS=
